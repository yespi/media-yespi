# Copiar a .env

# --- Modo B (recomendado): visitantes anónimos, admin usuario/clave, sin Google ---
AUTH_DISABLED=0
AUTH_PUBLIC_READ=1
AUTH_LOCAL=1

SESSION_SECRET=
COOKIE_DOMAIN=
COOKIE_SECURE=auto
PORT=8098

PORTAL_BRAND=Media Portal
FFMPEG_VENC=libx264
FFMPEG_PRESET=veryfast

# --- Modo C/D: Google (desactiva AUTH_LOCAL) ---
